# run artifacts — raw replies are kept locally, never published
runs/
*.jsonl
summary_*.json
speed_*.json
showdown_*.md
bakeoff_*.log
# the published result set (curated by hand, never the whole runs/ dir)
!results/
!results/summary_*.json
!results/speed_*.json
!results/showdown_*.md
!results/bakeoff_*.log
